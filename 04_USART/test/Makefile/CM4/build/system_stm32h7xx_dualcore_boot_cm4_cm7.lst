 421:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c **** /**
 422:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   * @brief  Exit Run* mode and Configure the system Power Supply
 423:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *
 424:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   * @note   This function exits the Run* mode and configures the system power supply
 425:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *         according to the definition to be used at compilation preprocessing level.
 426:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *         The application shall set one of the following configuration option:
 427:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_LDO_SUPPLY
 428:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_DIRECT_SMPS_SUPPLY
 429:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_EXTERNAL_SOURCE_SUPPLY
 430:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_SMPS_1V8_SUPPLIES_LDO
 431:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_SMPS_2V5_SUPPLIES_LDO
 432:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_SMPS_1V8_SUPPLIES_EXT_AND_LDO
 433:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_SMPS_2V5_SUPPLIES_EXT_AND_LDO
 434:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_SMPS_1V8_SUPPLIES_EXT
 435:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *           - PWR_SMPS_2V5_SUPPLIES_EXT
 436:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *
 437:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   * @note   The function modifies the PWR->CR3 register to enable or disable specific
 438:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *         power supply modes and waits until the voltage level flag is set, indicating
 439:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *         that the power supply configuration is stable.
 440:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   *
 441:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   * @param  None
 442:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   * @retval None
 443:../../Common/Src/system_stm32h7xx_dualcore_boot_cm4_cm7.c ****   */
