  90:../../CM7/Core/Src/main.c **** 
  91:../../CM7/Core/Src/main.c **** void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
  92:../../CM7/Core/Src/main.c **** {
  93:../../CM7/Core/Src/main.c ****   static const uint8_t msg_on[]  = "LED ON\r\n";
  94:../../CM7/Core/Src/main.c ****   static const uint8_t msg_off[] = "LED OFF\r\n";
  95:../../CM7/Core/Src/main.c **** 
  96:../../CM7/Core/Src/main.c ****   if (huart->Instance == USART1)
  97:../../CM7/Core/Src/main.c ****   {
  98:../../CM7/Core/Src/main.c ****     if (Size >= UART_RX_BUFFER_SIZE)
  99:../../CM7/Core/Src/main.c ****     {
 100:../../CM7/Core/Src/main.c ****       Size = UART_RX_BUFFER_SIZE - 1U;
 101:../../CM7/Core/Src/main.c ****     }
 102:../../CM7/Core/Src/main.c ****     Rx_data[Size] = 0;   /* terminate string for strstr() */
 103:../../CM7/Core/Src/main.c **** 
 104:../../CM7/Core/Src/main.c ****     if (strstr((char *)Rx_data, "LED ON") != NULL)
 105:../../CM7/Core/Src/main.c ****     {
 106:../../CM7/Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
 107:../../CM7/Core/Src/main.c ****       HAL_UART_Transmit_DMA(&huart1, (uint8_t *)msg_on, sizeof(msg_on) - 1U);
 108:../../CM7/Core/Src/main.c ****     }
 109:../../CM7/Core/Src/main.c ****     else if (strstr((char *)Rx_data, "LED OFF") != NULL)
 110:../../CM7/Core/Src/main.c ****     {
 111:../../CM7/Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
 112:../../CM7/Core/Src/main.c ****       HAL_UART_Transmit_DMA(&huart1, (uint8_t *)msg_off, sizeof(msg_off) - 1U);
 113:../../CM7/Core/Src/main.c ****     }
 114:../../CM7/Core/Src/main.c ****   }
 115:../../CM7/Core/Src/main.c **** 
 116:../../CM7/Core/Src/main.c ****   UART1_StartReceive();   /* re-arm, otherwise only the 1st frame is received */
 117:../../CM7/Core/Src/main.c **** }
