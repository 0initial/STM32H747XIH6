  65:../../CM7/Core/Src/main.c **** void RTC_ReadDateTime(uint8_t *hour, uint8_t *min, uint8_t *sec,
  66:../../CM7/Core/Src/main.c ****                       uint8_t *year, uint8_t *month, uint8_t *date, uint8_t *weekday)
  67:../../CM7/Core/Src/main.c **** {
  68:../../CM7/Core/Src/main.c ****     RTC_TimeTypeDef sTime = {0};
  69:../../CM7/Core/Src/main.c ****     RTC_DateTypeDef sDate = {0};
  70:../../CM7/Core/Src/main.c ****     HAL_RTC_GetTime(&hrtc, &sTime, RTC_FORMAT_BCD);
  71:../../CM7/Core/Src/main.c ****     HAL_RTC_GetDate(&hrtc, &sDate, RTC_FORMAT_BCD);
  72:../../CM7/Core/Src/main.c ****     if (hour)    *hour    = BCD2BIN(sTime.Hours);
  73:../../CM7/Core/Src/main.c ****     if (min)     *min     = BCD2BIN(sTime.Minutes);
  74:../../CM7/Core/Src/main.c ****     if (sec)     *sec     = BCD2BIN(sTime.Seconds);
  75:../../CM7/Core/Src/main.c ****     if (year)    *year    = BCD2BIN(sDate.Year);     /* 例：0x26 -> 26，表示 2026 */
  76:../../CM7/Core/Src/main.c ****     if (month)   *month   = BCD2BIN(sDate.Month);
  77:../../CM7/Core/Src/main.c ****     if (date)     *date    = BCD2BIN(sDate.Date);
  78:../../CM7/Core/Src/main.c ****     if (weekday) *weekday = BCD2BIN(sDate.WeekDay);   /* 1~7 */
  79:../../CM7/Core/Src/main.c **** }
