 708:../../Drivers/CMSIS/Include/cmsis_gcc.h **** {
 709:../../Drivers/CMSIS/Include/cmsis_gcc.h ****   if ((sat >= 1U) && (sat <= 32U))
 710:../../Drivers/CMSIS/Include/cmsis_gcc.h ****   {
